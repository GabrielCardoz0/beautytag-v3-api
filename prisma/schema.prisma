model forms {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  name          String
  description   String?
  forms_options forms_options[]
}

model forms_options {
  id            Int         @id @default(autoincrement())
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  service_id    Int
  form_id       Int
  form          forms       @relation(fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forms_options_fk1")
  options       services    @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forms_options_fk2")
  forms_options_secondary_options forms_options_secondary_options[]
}

model forms_options_secondary_options {
  id                Int           @id @default(autoincrement())
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  service_id        Int
  forms_options_id  Int
  forms_options     forms_options @relation(fields: [forms_options_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forms_options_secondary_options_fk1")
  options           services      @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forms_options_secondary_options_fk2")
}

model notifications {
  id          Int      @id @default(autoincrement())
  title       String
  body        String?
  type        String   @default("info")
  is_read     Boolean  @default(false)
  user_id     Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model plans {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  status        String
  user_id       Int
  users         users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "plans_fk1")
  plan_services plan_services[]
}

model plan_services {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  frequency     String
  plan_id       Int
  service_id    Int
  plan          plans    @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "plan_services_fk1")
  service       services @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "plan_services_fk2")
}

model instance {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  is_connected  Boolean
  whatsapp      String?
  evolution_id  String?
  base64        String?
}

model bot {
  id                  Int      @id @default(autoincrement())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  is_active           Boolean
  is_connected        Boolean
  welcome_msg         String?
  out_of_turn_msg     String?
  response_time       Int?
  start_time          Int?
  end_time            Int?
  name                String
  behavior            String
  company_description String
}

model invoices {
  id                      Int       @id @default(autoincrement())
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  user_id                 Int
  amount                  Int
  status                  String
  payment_date            DateTime?
  pagarme_transaction_id  String
  user                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model chat_histories {
  id              Int       @id @default(autoincrement())
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @db.Timestamp(6)
  chat_id         String
  role            String
  content         String?
  tool_calls      Json?
  tool_call_id    String?
  metadata        Json?
  is_from_human   Boolean   @default(false)
  @@index([chat_id, created_at])
}